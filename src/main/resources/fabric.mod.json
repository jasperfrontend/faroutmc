{
	"schemaVersion": 1,
	"id": "farout",
	"version": "${version}",
	"name": "Farout",
	"description": "Time how long it takes to walk 10,000 blocks in one direction.",
	"authors": [
		"Jasper van der Meer"
	],
	"contact": {
		"homepage": "https://www.curseforge.com/minecraft/mc-mods/farout",
		"sources": "https://github.com/jasperfrontend/faroutmc",
		"issues": "https://github.com/jasperfrontend/faroutmc/issues"
	},
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": [
			"nl.jasperfrontend.farout.Farout"
		],
		"client": [
			"nl.jasperfrontend.farout.client.FaroutClient"
		]
	},
	"mixins": [
		"farout.mixins.json",
		{
			"config": "farout.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
