// faroutmc.com: the static site in site/, served by a Worker.
// Deploy with: npx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "faroutmc",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site"
  },
  "routes": [
    { "pattern": "faroutmc.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
